# PostgreSQL
# Leave unset to use the bundled SQLite file (data/finance_tracker.db)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/finance

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AWS S3
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional: path to tesseract executable
TESSERACT_CMD=
