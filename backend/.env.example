# PostgreSQL
# Leave unset to use the bundled SQLite file (data/finance_tracker.db)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/finance

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google sign-in: OAuth Client ID (Web application) from console.cloud.google.com. Empty hides the button
GOOGLE_CLIENT_ID=

# OpenAI
OPENAI_API_KEY=
# Assistant chat model, and a cheaper model for extraction tasks (first available is used)
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini

# Email (OTP codes). For Gmail: SMTP_USER=you@gmail.com and SMTP_PASSWORD=<16-char App Password>
# Leave empty locally to print codes to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=FinanceAI

# AWS S3
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional: path to tesseract executable
TESSERACT_CMD=
